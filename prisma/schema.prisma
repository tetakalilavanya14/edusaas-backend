generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["education"]
}

model User {
  id                            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                          String                    @db.VarChar(255)
  username                      String?                   @unique @db.VarChar(255)
  clerk_id                      String?                   @unique @db.VarChar(255)
  email                         String                    @unique @db.VarChar(255)
  role_id                       String                    @db.Uuid
  password_hash                 String
  status                        String                    @default("active") @db.VarChar(50)
  last_login                    DateTime?                 @db.Timestamp(6)
  created_at                    DateTime                  @default(now()) @db.Timestamp(6)
  domain_role_id                String?                   @db.Uuid
  achievements                  Achievement[]
  announcements                 Announcement[]            @relation("EducatorAnnouncements")
  applications                  Application[]
  assessments                   Assessment[]
  authOtps                      AuthOtp?
  certificates                  Certificate[]
  courseProgress                CourseProgress[]
  courseRatings                 CourseRating[]
  community_bookmarks           community_bookmarks[]
  community_comments            community_comments[]
  community_posts               community_posts[]
  community_reactions           community_reactions[]
  taughtCourses                 Course[]                  @relation("EducatorCourses")
  enrollments                   Enrollment[]
  final_submissions             final_submissions[]
  gapReports                    GapReport[]
  jobs                          Job[]                     @relation("EmployerJobs")
  miniProjectAssignmentsCreated MiniProjectAssignment[]   @relation("EducatorMiniProjectAssignments")
  miniProjectSubmissions        MiniProjectSubmission[]   @relation("StudentMiniProjectSubmissions")
  notifications                 Notification[]
  profile                       Profile?
  progress                      Progress[]
  quizSessions                  QuizSession[]
  assessmentReports             AssessmentReport[]
  recommendations               Recommendation[]
  refreshTokens                 RefreshToken[]
  student_asked_questions       student_asked_questions[]
  studentProfiles               StudentProfile[]
  studentSkills                 StudentSkill[]
  subscriptions                 Subscription[]
  tasks                         Task[]
  user_coding_sessions          user_coding_sessions[]
  coding_submissions            coding_submissions[]
  role                          Role                      @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_role")
  domainRole                    DomainRole?               @relation(fields: [domain_role_id], references: [domain_role_id])
  sentConnections               Connection[]              @relation("SentConnections")
  receivedConnections           Connection[]              @relation("ReceivedConnections")

  @@index([role_id], map: "idx_users_role")
  @@index([domain_role_id])
  @@map("users")
  @@schema("education")
}

model Connection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String   @db.Uuid
  receiverId  String   @db.Uuid
  status      String   @default("pending") @db.VarChar(20) // 'pending', 'accepted', 'rejected'
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  requester User @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("connections")
  @@schema("education")
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?
  created_at  DateTime         @default(now()) @db.Timestamp(6)
  permissions RolePermission[]
  users       User[]

  @@map("roles")
  @@schema("education")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(150)
  description String?
  category    String?          @db.VarChar(100)
  created_at  DateTime         @default(now()) @db.Timestamp(6)
  roles       RolePermission[]

  @@map("permissions")
  @@schema("education")
}

model RolePermission {
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  assigned_at   DateTime   @default(now()) @db.Timestamp(6)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rolepermission_permission")
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rolepermission_role")

  @@id([role_id, permission_id])
  @@map("role_permissions")
  @@schema("education")
}

model Profile {
  id                           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                      String  @unique @db.Uuid
  career_goal                  String?
  institution                  String?
  company                      String?
  preferences                  Json?
  resume                       Json?
  initial_assessment_completed Boolean @default(false)
  user                         User    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_profile_user")

  @@map("profiles")
  @@schema("education")
}

model Assessment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  type           String    @db.VarChar(100)
  score          Float
  answers        Json?
  date_taken     DateTime  @default(now()) @db.Timestamp(6)
  career_goal    String?
  is_initial     Boolean   @default(false)
  total_marks    Int?
  obtained_marks Int?
  completed      Boolean   @default(false)
  started_at     DateTime? @db.Timestamp(6)
  completed_at   DateTime? @db.Timestamp(6)
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_assessment_user")

  @@index([user_id], map: "idx_assessment_user")
  @@map("assessments")
  @@schema("education")
}

model GapReport {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid

  readiness_score         Float
  initial_readiness_score Float?
  final_readiness_score   Float?

  missing_skills  String[]
  recommendations Json?

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_gapreport_user")

  @@index([user_id], map: "idx_gapreport_user")
  @@map("gap_reports")
  @@schema("education")
}

model CourseRating {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  course_id  String   @db.Uuid
  rating     Float
  review     String?
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  course     Course   @relation(fields: [course_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, course_id])
  @@index([course_id])
  @@map("course_ratings")
  @@schema("education")
}

model Course {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String               @db.VarChar(255)
  description         String?
  provider            String?              @db.VarChar(255)
  category            String?              @db.VarChar(255)
  difficulty          String?              @db.VarChar(50)
  status              String               @default("active") @db.VarChar(50)
  educator_id         String?              @db.Uuid
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  thumbnail_url       String?              @db.VarChar(500)
  certificates        Certificate[]
  educator            User?                @relation("EducatorCourses", fields: [educator_id], references: [id], onUpdate: NoAction, map: "fk_course_educator")
  enrollments         Enrollment[]
  recommendations     Recommendation[]
  tasks               Task[]
  coursePrerequisites CoursePrerequisite[] @relation("CoursePrerequisites")
  prerequisiteFor     CoursePrerequisite[] @relation("PrerequisiteCourse")
  courseProgress      CourseProgress[]
  courseRatings       CourseRating[]
  courseSkills        CourseSkill[]
  lessons             Lesson[]

  @@index([educator_id], map: "idx_courses_educator")
  @@map("courses")
  @@schema("education")
}

model CoursePrerequisite {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id              String   @db.Uuid
  prerequisite_course_id String   @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamp(6)
  updated_at             DateTime @default(now()) @db.Timestamp(6)

  course       Course @relation("CoursePrerequisites", fields: [course_id], references: [id])
  prerequisite Course @relation("PrerequisiteCourse", fields: [prerequisite_course_id], references: [id])

  @@map("course_prerequisites")
  @@schema("education")
}

model CourseProgress {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @db.Uuid
  course_id         String   @db.Uuid
  quiz_score        Float?
  assignment_status String?
  created_at        DateTime @default(now()) @db.Timestamp(6)

  course Course @relation(fields: [course_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("course_progress")
  @@schema("education")
}

model CourseSkill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id   String   @db.Uuid
  skill_id    Int
  skill_level Int?
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)

  course Course @relation(fields: [course_id], references: [id])
  skill  Skill  @relation(fields: [skill_id], references: [skill_id])

  @@map("course_skills")
  @@schema("education")
}

model Enrollment {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String   @db.Uuid
  course_id             String   @db.Uuid
  status                String   @default("active") @db.VarChar(50)
  completion_percentage Float    @default(0)
  enrolled_at           DateTime @default(now()) @db.Timestamp(6)
  course                Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_enrollment_course")
  user                  User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_enrollment_user")

  @@unique([user_id, course_id], map: "uq_enrollment")
  @@index([course_id], map: "idx_enrollment_course")
  @@index([user_id], map: "idx_enrollment_user")
  @@map("enrollments")
  @@schema("education")
}

model final_submissions {
  submission_id      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String               @db.Uuid
  domain_role_id     String               @db.Uuid
  assignment_id      String               @db.Uuid
  code               String
  submitted_at       DateTime?            @default(now()) @db.Timestamptz(6)
  domain_roles       DomainRole           @relation(fields: [domain_role_id], references: [domain_role_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_final_submission_domain_roles")
  user               User                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_final_submission_user")
  plagiarism_checks  plagiarism_checks[]
  plagiarism_matches plagiarism_matches[]

  @@schema("education")
}

model plagiarism_checks {
  plagiarism_check_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id       String    @db.Uuid
  status              String    @db.VarChar(30)
  highest_similarity  Decimal?  @db.Decimal(5, 2)
  comparison_count    Int       @default(0)
  checked_at          DateTime? @default(now()) @db.Timestamptz(6)

  final_submissions  final_submissions    @relation(fields: [submission_id], references: [submission_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_plagiarism_check_submission")
  plagiarism_matches plagiarism_matches[]

  @@schema("education")
}

model plagiarism_matches {
  match_id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plagiarism_check_id         String    @db.Uuid
  matched_submission_id       String    @db.Uuid
  original_token_similarity   Decimal?  @db.Decimal(5, 2)
  normalized_token_similarity Decimal?  @db.Decimal(5, 2)
  weighted_ast_similarity     Decimal?  @db.Decimal(5, 2)
  final_similarity            Decimal?  @db.Decimal(5, 2)
  risk_level                  String?   @db.VarChar(30)
  created_at                  DateTime? @default(now()) @db.Timestamptz(6)

  plagiarism_checks plagiarism_checks @relation(fields: [plagiarism_check_id], references: [plagiarism_check_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_plagiarism_match_check")
  final_submissions final_submissions @relation(fields: [matched_submission_id], references: [submission_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_plagiarism_match_submission")

  @@schema("education")
}


model Job {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employer_id              String   @db.Uuid
  title                    String   @db.VarChar(255)
  description              String?
  responsibilities         String?
  requirements             String?
  required_skills          String[]
  preferred_skills         String[] @default([])
  qualification            String?  @db.VarChar(255)
  eligible_branches        String[] @default([])
  employment_type          String?  @db.VarChar(100)
  work_mode                String?  @db.VarChar(100)
  location                 String?  @db.VarChar(255)
  salary                   String?  @db.VarChar(100)
  application_deadline     String?  @db.VarChar(100)
  require_video            Boolean? @default(false)
  video_max_duration       Int?     @default(60)
  video_prompt             String?
  status                   String   @default("open") @db.VarChar(50)
  created_at               DateTime @default(now()) @db.Timestamp(6)
  domain_role_id           String?  @db.Uuid
  minimum_experience_years Float?   @default(0)

  applications  Application[]
  jobSkills     JobSkill[]
  employer      User           @relation("EmployerJobs", fields: [employer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_job_employer")
  domainRole    DomainRole?    @relation(fields: [domain_role_id], references: [domain_role_id])
  notifications Notification[]

  @@index([employer_id], map: "idx_jobs_employer")
  @@map("jobs")
  @@schema("education")
}

model JobSkill {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id         String @db.Uuid
  skill_id       Int
  required_level Int?   @default(1)

  job   Job   @relation(fields: [job_id], references: [id])
  skill Skill @relation(fields: [skill_id], references: [skill_id])

  @@map("job_skills")
  @@schema("education")
}

model Application {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id           String      @db.Uuid
  student_id       String      @db.Uuid
  status           String      @default("submitted") @db.VarChar(50)
  skill_match      Float?
  applied_at       DateTime    @default(now()) @db.Timestamp(6)
  application_data Json?

  job        Job         @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_job")
  student    User        @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_student")
  interviews Interview[]

  @@unique([job_id, student_id], map: "uq_application")
  @@index([job_id], map: "idx_application_job")
  @@index([student_id], map: "idx_application_student")
  @@map("applications")
  @@schema("education")
}

model Interview {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String   @db.Uuid
  scheduled_at   DateTime @db.Timestamp(6)
  duration       Int      @default(30)
  interview_type String   @default("online") @db.VarChar(50)
  meeting_link   String?
  status         String   @default("scheduled") @db.VarChar(50)
  notes          String?
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamp(6)

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_interview_application")

  @@index([application_id], map: "idx_interview_application")
  @@map("interviews")
  @@schema("education")
}

model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  type         String    @db.VarChar(100)
  message      String
  read_status  Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  expires_at   DateTime? @db.Timestamp(6)
  job_id       String?   @db.Uuid
  reference_id String?   @db.VarChar(255)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_user")
  job  Job? @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_notification_user")
  @@index([job_id], map: "idx_notification_job")
  @@map("notifications")
  @@schema("education")
}

model Subscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  plan_type  String   @db.VarChar(100)
  start_date DateTime @db.Timestamp(6)
  end_date   DateTime @db.Timestamp(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subscription_user")

  @@index([user_id], map: "idx_subscription_user")
  @@map("subscriptions")
  @@schema("education")
}

model Report {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String    @db.VarChar(255)
  type         String    @db.VarChar(100)
  generated_at DateTime  @default(now()) @db.Timestamp(6)
  exported_at  DateTime? @db.Timestamp(6)
  format       String?   @db.VarChar(50)
  payload      Json?

  @@map("reports")
  @@schema("education")
}

model Setting {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope String @default("system") @db.VarChar(100)
  key   String @db.VarChar(255)
  value Json

  @@unique([scope, key], map: "uq_settings")
  @@map("settings")
  @@schema("education")
}

model Lesson {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id   String       @db.Uuid
  title       String       @db.VarChar(255)
  video_url   String?
  duration    Int?
  order_index Int          @default(0)
  created_at  DateTime     @default(now()) @db.Timestamp(6)
  assignments Assignment[]
  course      Course       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_lesson_course")
  progress    Progress[]
  quizzes     Quiz[]

  @@index([course_id], map: "idx_lessons_course")
  @@map("lessons")
  @@schema("education")
}

model Quiz {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id     String @db.Uuid
  questions     Json
  passing_score Int    @default(60)
  lesson        Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quiz_lesson")

  @@index([lesson_id], map: "idx_quizzes_lesson")
  @@map("quizzes")
  @@schema("education")
}

model Assignment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lesson_id       String   @db.Uuid
  instructions    String?
  submission_link String?
  created_at      DateTime @default(now()) @db.Timestamp(6)
  lesson          Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_assignment_lesson")

  @@index([lesson_id], map: "idx_assignments_lesson")
  @@map("assignments")
  @@schema("education")
}

model Progress {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  lesson_id         String    @db.Uuid
  watched_duration  Int       @default(0)
  quiz_score        Int?
  assignment_status String    @default("pending") @db.VarChar(50)
  completion_flag   Boolean   @default(false)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  completed_at      DateTime? @db.Timestamp(6)
  lesson            Lesson    @relation(fields: [lesson_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_progress_lesson")
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_progress_user")

  @@unique([user_id, lesson_id], map: "uq_progress")
  @@index([lesson_id], map: "idx_progress_lesson")
  @@index([user_id], map: "idx_progress_user")
  @@map("progress")
  @@schema("education")
}

model Certificate {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String        @db.Uuid
  course_id        String        @db.Uuid
  certificate_code String        @unique @db.VarChar(255)
  issued_date      DateTime      @default(now()) @db.Timestamp(6)
  achievements     Achievement[]
  course           Course        @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_certificate_course")
  user             User          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_certificate_user")

  @@index([course_id], map: "idx_certificates_course")
  @@index([user_id], map: "idx_certificates_user")
  @@map("certificates")
  @@schema("education")
}

model Achievement {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String       @db.Uuid
  badge_name     String       @db.VarChar(255)
  milestone      String?
  certificate_id String?      @db.Uuid
  earned_at      DateTime     @default(now()) @db.Timestamp(6)
  certificate    Certificate? @relation(fields: [certificate_id], references: [id], onUpdate: NoAction, map: "fk_achievement_certificate")
  user           User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_achievement_user")

  @@index([certificate_id], map: "idx_achievements_certificate")
  @@index([user_id], map: "idx_achievements_user")
  @@map("achievements")
  @@schema("education")
}

model Task {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  course_id    String?   @db.Uuid
  title        String    @db.VarChar(255)
  due_date     DateTime? @db.Timestamp(6)
  status       String    @default("pending") @db.VarChar(50)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  completed_at DateTime?
  course       Course?   @relation(fields: [course_id], references: [id], onUpdate: NoAction, map: "fk_task_course")
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_task_user")

  @@index([course_id], map: "idx_tasks_course")
  @@index([user_id], map: "idx_tasks_user")
  @@map("tasks")
  @@schema("education")
}

model Recommendation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  course_id  String   @db.Uuid
  reason     String?
  created_at DateTime @default(now()) @db.Timestamp(6)
  course     Course   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recommendation_course")
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_recommendation_user")

  @@index([course_id], map: "idx_recommendations_course")
