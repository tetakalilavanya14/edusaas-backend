  @@index([student_id], map: "idx_mini_project_submissions_student")
  @@index([status], map: "idx_mini_project_submissions_status")
  @@index([commit_sha], map: "idx_mini_project_submissions_commit_sha")
  @@map("mini_project_submissions")
  @@schema("education")
}

model MiniProjectAnalysis {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id          String    @unique @db.Uuid
  status                 String    @default("QUEUED") @db.VarChar(30)
  static_analysis_status String    @default("PENDING") @db.VarChar(30)
  plagiarism_status      String    @default("PENDING") @db.VarChar(30)
  ai_review_status       String    @default("NOT_REQUESTED") @db.VarChar(30)
  readiness_score        Decimal?  @db.Decimal(5, 2)
  languages              Json?
  project_type           String?   @db.VarChar(100)
  started_at             DateTime? @db.Timestamp(6)
  completed_at           DateTime? @db.Timestamp(6)
  error_message          String?
  created_at             DateTime  @default(now()) @db.Timestamp(6)
  updated_at             DateTime  @updatedAt

  submission       MiniProjectSubmission       @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  findings         StaticAnalysisFinding[]
  plagiarism_check MiniProjectPlagiarismCheck?

  @@index([status], map: "idx_mini_project_analysis_status")
  @@index([static_analysis_status], map: "idx_mini_project_analysis_static_status")
  @@index([plagiarism_status], map: "idx_mini_project_analysis_plagiarism_status")
  @@map("mini_project_analysis")
  @@schema("education")
}

model StaticAnalysisFinding {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id String   @db.Uuid
  severity    String   @db.VarChar(20)
  category    String   @db.VarChar(100)
  rule        String   @db.VarChar(255)
  file        String   @db.VarChar(1000)
  line        Int?
  message     String
  created_at  DateTime @default(now()) @db.Timestamp(6)

  analysis MiniProjectAnalysis @relation(fields: [analysis_id], references: [id], onDelete: Cascade)

  @@index([analysis_id], map: "idx_static_analysis_findings_analysis")
  @@index([severity], map: "idx_static_analysis_findings_severity")
  @@index([category], map: "idx_static_analysis_findings_category")
  @@map("static_analysis_findings")
  @@schema("education")
}

model MiniProjectPlagiarismCheck {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id        String   @unique @db.Uuid
  status             String   @db.VarChar(30)
  highest_similarity Decimal? @db.Decimal(5, 2)
  comparison_count   Int      @default(0)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @updatedAt

  analysis MiniProjectAnalysis          @relation(fields: [analysis_id], references: [id], onDelete: Cascade)
  matches  MiniProjectPlagiarismMatch[]

  @@map("mini_project_plagiarism_checks")
  @@schema("education")
}

model MiniProjectPlagiarismMatch {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plagiarism_check_id   String   @db.Uuid
  matched_submission_id String   @db.Uuid
  similarity            Decimal? @db.Decimal(5, 2)
  risk_level            String?  @db.VarChar(30)
  matched_files         Json?
  created_at            DateTime @default(now()) @db.Timestamp(6)

  plagiarism_check MiniProjectPlagiarismCheck @relation(fields: [plagiarism_check_id], references: [id], onDelete: Cascade)

  @@index([plagiarism_check_id], map: "idx_mini_project_plagiarism_matches_check")
  @@index([matched_submission_id], map: "idx_mini_project_plagiarism_matches_submission")
  @@map("mini_project_plagiarism_matches")
  @@schema("education")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_coding_sessions {
  session_id          Int                  @id
  user_id             String               @db.Uuid
  total_score         Decimal?             @default(0.00) @db.Decimal(5, 2)
  max_score           Decimal?             @default(300.00) @db.Decimal(5, 2)
  questions_completed Int?                 @default(0)
  status              String?              @default("In Progress") @db.VarChar(20)
  started_at          DateTime?            @default(now()) @db.Timestamp(6)
  completed_at        DateTime?            @db.Timestamp(6)
  deadline_at         DateTime?
  remaining_seconds   Int?
  coding_submissions  coding_submissions[]
  quiz_sessions       QuizSession          @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_coding_parent_session")
  users               User                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_session_user")

  @@schema("education")
}

