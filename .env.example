# ==============================================================================
# EduSaaS Backend Environment Configuration Template
# Copy this file to .env and populate with production values before deployment.
# ==============================================================================

PORT=5000
NODE_ENV=production
APP_ENV=production

# JWT Authentication
# Generate strong 64-byte random strings in production
JWT_SECRET=replace-with-a-secure-random-secret
JWT_REFRESH_SECRET=replace-with-another-secure-random-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Password Recovery / Email (SMTP)
SMTP_USER=your-email@domain.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=EduSaaS Platform <noreply@domain.com>

# CORS Origins
# Comma-separated list of allowed frontend domains
CORS_ORIGINS=https://app.yourdomain.com,https://your-cloudfront-id.cloudfront.net

# Unified AI/ML Service
AIML_SERVICE_URL=https://edusaas-aiml-parb.onrender.com
AIML_BASE_URL=https://edusaas-aiml-parb.onrender.com
FRAUD_AI_WS_URL=wss://edusaas-aiml-parb.onrender.com/ws/proctor
FLASK_QUIZ_URL=https://edusaas-aiml-parb.onrender.com
PLAGIARISM_BASE_URL=https://edusaas-aiml-parb.onrender.com
AIML_TIMEOUT_MS=60000

# PostgreSQL Connection String (AWS RDS)
DATABASE_URL=postgresql://postgres:yourpassword@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/edu_saas?schema=Education&sslmode=require

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_aW5jbHVkZWQtYmx1ZWdpbGwtNTI1MS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_CcXIZeamGJtBwraaU7jcLIxrU7t8uh3WLSz4hHRLEl
CLERK_WEBHOOK_SECRET=

# Assessment Settings
INITIAL_ASSESSMENT_DURATION_MINUTES=30
INITIAL_CODING_ASSESSMENT_DURATION_MINUTES=45
ANALYSIS_WORKER_INTERVAL_MS=10000
